{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silasxlx/classical-ml-lab/schemas/run.schema.json",
  "title": "classical-ml-lab run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "seed",
    "config_hash",
    "started_at",
    "completed_at",
    "environment",
    "experiments",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 16 },
    "status": { "enum": ["success", "failed"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "package_version", "scikit_learn"],
      "properties": {
        "python": { "type": "string" },
        "platform": { "enum": ["windows", "linux", "darwin"] },
        "package_version": { "type": "string" },
        "scikit_learn": { "type": "string" }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "metrics_path", "figures"],
        "properties": {
          "id": {
            "enum": [
              "decision-tree",
              "random-forest",
              "adaboost",
              "svm",
              "logistic-regression",
              "knn",
              "naive-bayes",
              "kmeans"
            ]
          },
          "status": { "const": "success" },
          "metrics_path": { "type": "string", "pattern": "^experiments/" },
          "figures": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^experiments/.+\\.png$" }
          }
        }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
